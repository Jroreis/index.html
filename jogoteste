<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farm & Defend - Movimento</title>
    <style>
        body { margin: 0; background: #111; color: white; text-align: center; overflow: hidden; touch-action: none; }
        canvas { background: #7ba849; display: block; margin: 0 auto; border: 2px solid #333; }
        .ui-container { position: absolute; top: 10px; width: 100%; display: flex; justify-content: center; }
        .inventory { padding: 10px 20px; border-radius: 8px; background: rgba(0,0,0,0.8); display: none; }
        .inventory.active { display: block; border: 3px solid #ffd700; }

        /* Estilo dos Botões de Controle */
        .controls { position: absolute; bottom: 20px; width: 100%; display: flex; justify-content: center; gap: 10px; }
        .btn-move { width: 60px; height: 60px; background: rgba(255,255,255,0.3); border-radius: 50%; border: none; color: white; font-size: 20px; }
    </style>
</head>
<body>

    <div class="ui-container">
        <div id="inv-farm" class="inventory active">🌱 Plantação</div>
        <div id="inv-def" class="inventory">⚔️ Defesa</div>
    </div>

    <canvas id="gameCanvas" width="360" height="500"></canvas>

    <!-- Controles na tela -->
    <div class="controls">
        <button class="btn-move" onpointerdown="move('left')" onpointerup="stop()">◀️</button>
        <button class="btn-move" onpointerdown="move('up')" onpointerup="stop()">🔼</button>
        <button class="btn-move" onpointerdown="move('down')" onpointerup="stop()">🔽</button>
        <button class="btn-move" onpointerdown="move('right')" onpointerup="stop()">▶️</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // Dados do Jogador
        let player = { x: 160, y: 250, size: 40, speed: 4, dx: 0, dy: 0 };
        let isDaytime = true;

        // Movimentação
        function move(dir) {
            if(dir === 'left') player.dx = -player.speed;
            if(dir === 'right') player.dx = player.speed;
            if(dir === 'up') player.dy = -player.speed;
            if(dir === 'down') player.dy = player.speed;
        }
        function stop() { player.dx = 0; player.dy = 0; }

        // Suporte a Teclado (para PC)
        window.addEventListener('keydown', (e) => {
            if(e.key === 'ArrowLeft') move('left');
            if(e.key === 'ArrowRight') move('right');
            if(e.key === 'ArrowUp') move('up');
            if(e.key === 'ArrowDown') move('down');
        });
        window.addEventListener('keyup', stop);

        function drawGame() {
            // Atualiza posição
            player.x += player.dx;
            player.y += player.dy;

            // Limpa tela e desenha fundo
            ctx.fillStyle = isDaytime ? '#7ba849' : '#1a1c23';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Desenha jogador
            ctx.fillStyle = '#ffcc00';
            ctx.fillRect(player.x, player.y, player.size, player.size);

            requestAnimationFrame(drawGame);
        }
        drawGame();
    </script>
</body>
</html>
