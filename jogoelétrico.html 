            <button id="modeProbe" type="button" class="tool-btn px-2 py-2 rounded-lg bg-slate-800 border border-slate-700 text-xs font-semibold flex flex-col items-center gap-1">
              <span class="text-base">📟</span>
              <span>Multímetro</span>
            </button>
          </div>
        </div>

        <!-- Wire Color (Conductor Type) -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">2. Cor do Condutor (Padrão NBR 5410)</label>
          <div class="grid grid-cols-2 gap-1.5" id="wireColorButtons">
