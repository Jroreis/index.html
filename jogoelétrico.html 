          <span id="statusBannerText" class="text-xs font-medium text-slate-300">
            Toque em um borne de origem e depois no borne de destino para passar o condutor.
          </span>
        </div>
        <div class="flex items-center gap-3 text-xs mono">
          <div class="px-2.5 py-1 rounded bg-slate-950 border border-slate-800 text-slate-300">
