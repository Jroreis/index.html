      if (result.ok) {
        icon.className = 'w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-2xl';
        icon.textContent = '⚡';
        nextBtn.classList.toggle('hidden', GameState.currentLevelIdx >= LEVELS.length - 1);
      } else {
        icon.className = 'w-12 h-12 rounded-xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-2xl';
        icon.textContent = result.shortCircuit ? '💥' : '⚠️';
