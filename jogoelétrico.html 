    // =========================================================================
    // 6. CIRCUIT VALIDATION & SIMULATION ENGINE
    // =========================================================================
    function buildAdjacency() {
      const adj = {};
      const lvl = currentLevel();
      lvl.components.forEach(c => {
        c.terminals.forEach(t => { adj[t.id] = []; });
      });
      GameState.wires.forEach(w => {
        if (adj[w.from] && adj[w.to]) {
          adj[w.from].push({ to: w.to, wire: w });
          adj[w.to].push({ to: w.from, wire: w });
        }
      });
      // Internal busbar short-paths
      lvl.components.forEach(c => {
        if (c.type === 'bus_n' || c.type === 'bus_pe') {
          for (let i = 0; i < c.terminals.length; i++) {
            for (let j = i + 1; j < c.terminals.length; j++) {
              const a = c.terminals[i].id;
              const b = c.terminals[j].id;
              adj[a].push({ to: b, internal: true });
              adj[b].push({ to: a, internal: true });
            }
          }
        }
      });
      return adj;
    }

    function areConnected(adj, setA, setB) {
      const visited = new Set();
      const queue = [...setA];
      queue.forEach(id => visited.add(id));
      while (queue.length > 0) {
        const curr = queue.shift();
        if (setB.includes(curr)) return true;
        const neighbors = adj[curr] || [];
        for (const edge of neighbors) {
          if (!visited.has(edge.to)) {
            visited.add(edge.to);
            queue.push(edge.to);
          }
        }
      }
      return false;
    }

    function findDirectMatchingWire(req) {
      // Check if there is a wire connecting any terminal in req.from to any terminal in req.to
      return GameState.wires.find(w =>
        (req.from.includes(w.from) && req.to.includes(w.to)) ||
        (req.from.includes(w.to) && req.to.includes(w.from))
      );
    }

    function evaluateCircuit() {
      const lvl = currentLevel();
      const adj = buildAdjacency();

      // 1. Check for Direct Short Circuits (Fase directly tied to Neutro or Terra)
      const faseSources = [];
      const fase2Sources = [];
      const neutroSources = [];
      const peSources = [];

      lvl.components.forEach(c => {
        c.terminals.forEach(t => {
          if (t.role === 'source_f1') faseSources.push(t.id);
          if (t.role === 'source_f2') fase2Sources.push(t.id);
          if (t.role === 'source_n' || t.role === 'source_n_raw') neutroSources.push(t.id);
          if (t.role === 'source_pe') peSources.push(t.id);
        });
      });

      const hasFaseNeutroShort = faseSources.length && neutroSources.length && areConnected(adj, faseSources, neutroSources);
      const hasFaseTerraShort = faseSources.length && peSources.length && areConnected(adj, faseSources, peSources);
      const hasFase1Fase2Short = faseSources.length && fase2Sources.length && areConnected(adj, faseSources, fase2Sources);

      if (hasFaseNeutroShort || hasFaseTerraShort || hasFase1Fase2Short) {
        let reason = 'Curto-circuito franco detectado entre Fase e Neutro!';
        if (hasFaseTerraShort) reason = 'Fuga/Curto direto entre Fase e Terra (PE)! O Disjuntor/DR atuou imediatamente.';
        if (hasFase1Fase2Short) reason = 'Curto-circuito bifásico direto entre Fase L1 e Fase L2!';
        return {
          ok: false,
          shortCircuit: true,
          stars: 0,
          headline: 'CURTO-CIRCUITO! Disjuntor Desarmou!',
          message: reason,
          details: [
            { ok: false, text: reason },
            { ok: false, text: 'Revise os condutores e remova a ligação direta entre barramentos/fases com o Alicate.' }
          ]
        };
      }

      // 2. Check all required links for the current level
      const missingLinks = [];
      const wrongColorLinks = [];
      const wrongGaugeLinks = [];
      const details = [];

      // Special symmetric handling for Level 4 parallel travelers (P1-P1/P2-P2 or crossed P1-P2/P2-P1)
      let reqList = lvl.requiredLinks;
      if (lvl.id === 4) {
        const straight = findDirectMatchingWire({ from: ['swp1_p1'], to: ['swp2_p1'] }) &&
                         findDirectMatchingWire({ from: ['swp1_p2'], to: ['swp2_p2'] });
        const crossed  = findDirectMatchingWire({ from: ['swp1_p1'], to: ['swp2_p2'] }) &&
                         findDirectMatchingWire({ from: ['swp1_p2'], to: ['swp2_p1'] });
        if (!straight && crossed) {
          reqList = [
            lvl.requiredLinks[0],
            { from: ['swp1_p1'], to: ['swp2_p2'], color: 'retorno', minGauge: 1.5, desc: 'Retorno paralelo cruzado 1 entre interruptores' },
            { from: ['swp1_p2'], to: ['swp2_p1'], color: 'retorno', minGauge: 1.5, desc: 'Retorno paralelo cruzado 2 entre interruptores' },
            lvl.requiredLinks[3],
            lvl.requiredLinks[4]
          ];
        }
      }

      for (const req of reqList) {
        const w = findDirectMatchingWire(req);
        if (!w) {
          missingLinks.push(req.desc);
          details.push({ ok: false, text: `Faltando: ${req.desc}` });
        } else {
          const colorOk = w.color === req.color;
          const gaugeOk = w.gauge >= req.minGauge;
          if (!colorOk) {
            wrongColorLinks.push(`${req.desc} (usado ${WIRE_COLORS[w.color].name}, recomendado ${WIRE_COLORS[req.color].name})`);
          }
          if (!gaugeOk) {
            wrongGaugeLinks.push(`${req.desc} (usado ${w.gauge.toFixed(1).replace('.', ',')} mm², mínimo ${req.minGauge.toFixed(1).replace('.', ',')} mm²)`);
          }
          if (colorOk && gaugeOk) {
            details.push({ ok: true, text: `Correto: ${req.desc} (${w.gauge.toFixed(1).replace('.', ',')} mm²)` });
          } else {
            details.push({
              ok: false,
              text: `Atenção em ${req.desc}: cor ${colorOk ? 'OK' : 'fora do padrão'} / bitola ${gaugeOk ? 'OK' : 'abaixo do mínimo (' + req.minGauge.toFixed(1).replace('.', ',') + ' mm²)'}`
            });
          }
        }
      }

      // Check for unexpected extra wires that cause wrong topology
      if (missingLinks.length > 0) {
        return {
          ok: false,
          shortCircuit: false,
          stars: 0,
          headline: 'Circuito Incompleto',
          message: 'Algumas conexões essenciais ainda não foram feitas. Confira os itens pendentes abaixo:',
          details
        };
      }

      // Calculate stars (1 to 3)
      let stars = 3;
      if (wrongColorLinks.length > 0) stars -= 1;
      if (wrongGaugeLinks.length > 0) stars -= 1;
      if (stars < 1) stars = 1;

      let message = 'Parabéns! Todas as conexões, cores padronizadas da NBR 5410 e seções mínimas (bitolas) foram instaladas com perfeição!';
      if (stars === 2) {
        message = 'O circuito funciona! Porém, você perdeu 1 estrela por detalhe de padronização de cor ou bitola abaixo do recomendado. Veja o diagnóstico abaixo:';
      } else if (stars === 1) {
        message = 'O circuito fechou contato, mas há não-conformidades tanto nas cores dos condutores quanto na seção mínima (bitola) dos cabos!';
      }

      return {
        ok: true,
        shortCircuit: false,
        stars,
        headline: stars === 3 ? 'Instalação Padrão Ouro (3 Estrelas)!' : 'Circuito Funcionando (' + stars + ' Estrelas)',
        message,
        details
      };
    }

    // Check if loads should be visually active when energized
    function isLoadActive(comp) {
      if (!GameState.energized || !GameState.circuitValid || GameState.shortCircuitTripped) return false;
      const lvl = currentLevel();
      if (comp.type === 'lamp') {
        if (lvl.id === 1 || lvl.id === 3) {
          const sw = lvl.components.find(c => c.type === 'switch_simple');
          return sw ? sw.stateOn : true;
        }
        if (lvl.id === 4) {
          const sws = lvl.components.filter(c => c.type === 'switch_parallel');
          if (sws.length === 2) {
            return sws[0].statePos === sws[1].statePos;
          }
        }
        return true;
      }
      if (comp.type === 'outlet' || comp.type === 'shower') {
        const idr = lvl.components.find(c => c.type === 'idr');
        if (idr && !idr.stateOn) return false;
        return true;
      }
      return false;
    }

    function spawnSparks(x, y) {
      for (let i = 0; i < 28; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 6;
        GameState.sparks.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 1.5,
          life: 1.0,
          color: Math.random() > 0.4 ? '#facc15' : '#f97316'
        });
      }
    }

