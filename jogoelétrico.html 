        <div class="flex items-center justify-between gap-2 mb-1.5">
          <span id="levelBadge" class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Fase 1 • Iniciante
          </span>
          <div id="levelStarsDisplay" class="text-amber-400 text-sm tracking-widest">☆☆☆</div>
        </div>
        <h2 id="levelTitle" class="text-base font-bold text-white mb-1">Ponto Simples de Iluminação</h2>
        <p id="levelDesc" class="text-xs text-slate-300 leading-relaxed mb-3"></p>

        <!-- Technical Checklist -->
        <div class="bg-slate-950/80 border border-slate-800/90 rounded-lg p-2.5 space-y-1.5">
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 flex items-center justify-between">
            <span>Requisitos da Instalação</span>
            <span id="reqBitolaBadge" class="mono text-amber-300">1,5 mm²</span>
          </div>
          <ul id="levelChecklist" class="text-xs space-y-1 text-slate-300"></ul>
        </div>
      </div>

      <!-- Tool & Wire Palette -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5 shadow-lg space-y-3">
        <!-- Interaction Mode -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">1. Modo da Ferramenta</label>
          <div class="grid grid-cols-3 gap-1.5">
