    </div>
  </div>

  <!-- Hint Modal -->
  <div id="hintModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-indigo-500/40 rounded-2xl max-w-md w-full p-5 shadow-2xl space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-extrabold text-indigo-300 flex items-center gap-2">
          <span>💡</span> Guia Técnico da Fase
        </h3>
        <button id="btnCloseHint" type="button" class="text-slate-400 hover:text-white text-lg font-bold px-2">✕</button>
      </div>
      <div id="hintContent" class="text-xs sm:text-sm text-slate-300 space-y-2 leading-relaxed"></div>
      <div class="pt-2 flex justify-end">
        <button id="btnDismissHint" type="button" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition">
          Entendi, vamos instalar!
        </button>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // 1. SYNTHESIZED SOUND ENGINE (Web Audio API)
    // =========================================================================
    const SoundFX = {
      ctx: null,
      muted: false,
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },
      playTone(freq, type, duration, vol = 0.12) {
        if (this.muted) return;
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          gain.gain.setValueAtTime(vol, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch (e) {}
      },
      click() { this.playTone(520, 'sine', 0.06, 0.1); },
      connect() {
        this.playTone(440, 'triangle', 0.08, 0.14);
        setTimeout(() => this.playTone(660, 'triangle', 0.12, 0.14), 60);
      },
      cut() { this.playTone(220, 'sawtooth', 0.09, 0.12); },
      switchToggle() { this.playTone(780, 'square', 0.04, 0.08); },
      shortCircuit() {
        this.playTone(110, 'sawtooth', 0.28, 0.2);
        setTimeout(() => this.playTone(85, 'sawtooth', 0.35, 0.22), 90);
      },
      success() {
        const notes = [523.25, 659.25, 783.99, 1046.5];
        notes.forEach((n, i) => {
          setTimeout(() => this.playTone(n, 'triangle', 0.18, 0.15), i * 90);
        });
      }
    };

    // =========================================================================
    // 2. WIRE COLOR & GAUGE DEFINITIONS
    // =========================================================================
