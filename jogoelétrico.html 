            <button type="button" data-gauge="2.5" class="wire-gauge-btn tool-btn py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs font-bold mono text-center">
              2,5
            </button>
            <button type="button" data-gauge="4.0" class="wire-gauge-btn tool-btn py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs font-bold mono text-center">
              4,0
            </button>
            <button type="button" data-gauge="6.0" class="wire-gauge-btn tool-btn py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs font-bold mono text-center">
              6,0
            </button>
