  <!-- Result / Feedback Modal -->
  <div id="feedbackModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-5 shadow-2xl space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <div id="modalIcon" class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-2xl">
            ✅
          </div>
          <div>
            <h3 id="modalTitle" class="text-lg font-extrabold text-white">Instalação Aprovada!</h3>
            <div id="modalStars" class="text-amber-400 text-lg tracking-widest">★★★</div>
          </div>
        </div>
        <button id="btnCloseModalTop" type="button" class="text-slate-400 hover:text-white text-lg font-bold px-2">✕</button>
      </div>

      <p id="modalMessage" class="text-xs sm:text-sm text-slate-300 leading-relaxed"></p>

      <div id="modalDiagnostics" class="bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-1.5 text-xs"></div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button id="btnModalKeepTesting" type="button" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition">
          Continuar no Quadro
        </button>
        <button id="btnModalNextLevel" type="button" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-extrabold transition">
