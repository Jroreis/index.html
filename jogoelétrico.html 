        <!-- Wire Gauge (Bitola) -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">3. Seção / Bitola do Cabo (mm²)</label>
          <div class="grid grid-cols-4 gap-1.5" id="wireGaugeButtons">
            <button type="button" data-gauge="1.5" class="wire-gauge-btn tool-btn active py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs font-bold mono text-center">
              1,5
