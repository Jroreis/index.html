<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Mestre da Elétrica — Simulador de Instalações</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0f172a;
      color: #f8fafc;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    canvas {
      touch-action: none;
      display: block;
    }
    .tool-btn {
      transition: all 0.15s ease;
    }
    .tool-btn.active {
      transform: translateY(-2px);
      box-shadow: 0 0 0 2px #facc15, 0 4px 12px rgba(250, 204, 21, 0.25);
    }
    .level-pill.locked {
      opacity: 0.5;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #1e293b; }
    ::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-950 text-slate-100">

  <!-- Top Header -->
  <header class="bg-slate-900/95 border-b border-slate-800 px-3 py-2.5 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-400 font-bold text-lg shadow-inner">
          ⚡
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white flex items-center gap-2">
            Mestre da Elétrica
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">NBR 5410</span>
          </h1>
          <p class="text-[11px] text-slate-400 hidden sm:block">Do ponto simples de iluminação à montagem completa de QDC</p>
        </div>
      </div>

      <!-- Level Selector Bar -->
      <div id="levelSelector" class="flex items-center gap-1 overflow-x-auto max-w-full py-0.5"></div>

      <!-- Utility Controls -->
      <div class="flex items-center gap-1.5">
        <div class="px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-xs font-semibold flex items-center gap-1.5">
          <span class="text-amber-400">★</span>
          <span id="totalStarsLabel" class="mono">0/18</span>
        </div>
        <button id="btnHint" type="button" class="px-2.5 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 text-xs font-semibold transition">
          💡 Dica
        </button>
        <button id="btnAudio" type="button" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-semibold transition" title="Ativar/Desativar Som">
          🔊 Som
        </button>
        <button id="btnResetProgress" type="button" class="px-2 py-1.5 rounded-lg bg-slate-800 hover:bg-rose-950/60 border border-slate-700 hover:border-rose-700/50 text-slate-400 hover:text-rose-300 text-xs transition" title="Reiniciar Progresso">
          ↺
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-2 sm:p-3 grid grid-cols-1 lg:grid-cols-12 gap-3">

    <!-- Left/Top Sidebar: Level Mission & Controls -->
    <aside class="lg:col-span-4 xl:col-span-3 flex flex-col gap-2.5">
      <!-- Current Level Card -->
