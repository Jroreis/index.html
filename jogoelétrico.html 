      </div>

      <!-- Interactive Canvas Container -->
      <div id="canvasContainer" class="relative flex-1 min-h-[430px] sm:min-h-[520px] bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-inner">
