        <!-- Floating Legend Overlay -->
        <div class="absolute bottom-2.5 left-2.5 right-2.5 pointer-events-none flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400 bg-slate-950/80 backdrop-blur-sm border border-slate-800/80 px-3 py-1.5 rounded-lg">
          <div class="flex flex-wrap items-center gap-3">
            <span class="flex items-center gap-1"><i class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></i> Fase (L)</span>
